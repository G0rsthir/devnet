# Copy to .env (gitignored) and fill in. Compose passes it to the containers via env_file.
# Keep comments on their own lines, so they never end up in a value.

# --- Shared, no prefix: devnet-core settings, Ansible's nb_inventory ---
# development | production. devnet-api's dev/prod factory overrides it for the server.
ENVIRONMENT=development
NETBOX_API=https://netbox.example.com
NETBOX_TOKEN=
DEVICE_USER=
DEVICE_PASSWORD=

# --- devnet-api: DEVNET_API_ prefix ---
# openssl rand -base64 32
DEVNET_API_ACCESS_JWT_SECRET=change_me
DEVNET_API_REFRESH_JWT_SECRET=change_me
# jti of tokens to reject before they expire, as JSON: ["b9bf...", ...]. Use [] for none: an empty value fails
DEVNET_API_REVOKED_JWT_TOKENS=[]

# --- Prefect: read by Prefect itself ---

#PREFECT_API_AUTH_STRING=admin:dev

# Unset = a temporary local server. Set it to use your Prefect server.
# PREFECT_API_URL=http://prefect.example.com:4200/api
# Logging for local flow runs, incl. the devnet logger. Relative to the repo root: run from there.
# If the file isn't found, Prefect silently falls back to its default config.
PREFECT_LOGGING_SETTINGS_PATH=services/devnet-flows/logging.yaml
PREFECT_LOGGING_TO_API_WHEN_MISSING_FLOW=ignore