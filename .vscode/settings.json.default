{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.includeAliasesFromUserFiles": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact][typescript][css][javascript][jsonc][yaml]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.eslint": "always"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/py.typed": true,
    "**/.import_linter_cache": true,
    "**/.mypy_cache": true
  },
  "search.exclude": {
    "**/__pycache__": true,
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "python.terminal.useEnvFile": true,
  "github.copilot.enable": {
     "*": false
  },
  "flake8.path": ["${workspaceFolder}/.venv/bin/flake8"],
  "flake8.cwd": "${fileDirname}",
  "flake8.args": ["--toml-config=${workspaceFolder}/pyproject.toml"]
}