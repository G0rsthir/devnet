FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    # The server writes UI files at startup; the venv isn't writable by the devnet user.
    PREFECT_UI_STATIC_DIRECTORY=/tmp/prefect-ui \
    # Logging for the worker and its flow runs, including the devnet logger. devnet-api has its own.
    PREFECT_LOGGING_SETTINGS_PATH=/app/services/devnet-flows/logging.yaml \
    PREFECT_LOGGING_TO_API_WHEN_MISSING_FLOW=ignore

WORKDIR /app

# Third-party dependencies only, so this layer is rebuilt only when uv.lock changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev --no-install-workspace

# Your code: workspace packages
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

RUN useradd --create-home devnet
USER devnet